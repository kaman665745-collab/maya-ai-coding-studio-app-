# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Never expose this key in client-side Vite bundles.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of this ACS instance.
APP_URL="http://localhost:3000"

# Cloud SQL / PostgreSQL connection variables (Object Method)
SQL_HOST="/cloudsql/PROJECT:REGION:INSTANCE"
SQL_DB_NAME="acs_studio"
SQL_USER="acs_app"
SQL_PASSWORD="change_me"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="change_me"

# Optional sandbox execution limits
ACS_SANDBOX_TIMEOUT_MS="15000"
ACS_SANDBOX_MAX_MEMORY_MB="256"
ACS_STORAGE_DIR=".acs-storage"
